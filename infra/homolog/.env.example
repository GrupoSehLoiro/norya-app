# =============================================================================
# Homolog SEHLORO (DigitalOcean) — copie para .env NA DROPLET e preencha.
# NUNCA commitar o .env preenchido. Runbook completo:
# docs/technical/homolog-digitalocean.md
# =============================================================================

# ----------------------------------------------------------------------------
# Borda / TLS
# ----------------------------------------------------------------------------
# Domínio apontando (registro A) para o IP da droplet. Twitch/Kick exigem
# HTTPS no redirect_uri — IP puro não serve.
DOMAIN=homolog.exemplo.com.br
# E-mail para os avisos de expiração do Let's Encrypt.
ACME_EMAIL=victorcordeiro.contact@gmail.com

# ----------------------------------------------------------------------------
# Segredos — gerar na hora, um por ambiente. NÃO reutilizar valores de dev.
# ----------------------------------------------------------------------------
# openssl rand -base64 48
JWT_SECRET=
# openssl rand -base64 32   (base64 de EXATOS 32 bytes)
CRYPTO_MASTER_KEY=
# openssl rand -hex 24
MONGO_INITDB_ROOT_USERNAME=sehloro
MONGO_INITDB_ROOT_PASSWORD=
# openssl rand -hex 24
CLICKHOUSE_PASSWORD=
CLICKHOUSE_USER=default
CLICKHOUSE_DB=sehloro
# openssl rand -hex 16 — usado pelo fallback webhook EventSub (HMAC).
TWITCH_WEBHOOK_SECRET=

# ----------------------------------------------------------------------------
# Página/endpoint de access logs (console /logs + GET /api/v2/logs).
# Basic Auth operacional, separada do JWT. Sem os dois: endpoint responde 404.
# Senha: mínimo 12 chars — openssl rand -hex 12
# ----------------------------------------------------------------------------
LOGS_USER=ops
LOGS_PASSWORD=

# ----------------------------------------------------------------------------
# Primeiro admin do console (bootstrap idempotente no boot da API).
# Cria a conta ativa/verificada com role=admin se não existir; nunca promove
# conta existente. Demais admins: página "Gerenciador de acesso" (/access).
# Senha: mínimo 12 chars.
# ----------------------------------------------------------------------------
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# ----------------------------------------------------------------------------
# Twitch / Kick — credenciais da APP Sehloro (dev.twitch.tv / kick.com/settings)
# Cadastrar redirect URIs:
#   https://${DOMAIN}/api/v2/auth/twitch/callback
#   https://${DOMAIN}/api/v2/auth/kick/callback
# ----------------------------------------------------------------------------
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_BOT_USER_ID=
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# ----------------------------------------------------------------------------
# IA Core (M4) — subir com mock; flipar p/ real na validação do tier-2.
# ----------------------------------------------------------------------------
LLM_DRIVER=mock
ANTHROPIC_API_KEY=
LLM_MODEL_TIER2=claude-haiku-4-5-20251001
# CSV de channelIds ativos no pipeline (vazio = orchestrator IDLE; também
# controlável pelo toggle "ao vivo" do console).
SOCIAL_LISTENING_CHANNELS=
SOCIAL_LISTENING_TICK_MS=15000
SOCIAL_LISTENING_WINDOW_MS=15000

# ----------------------------------------------------------------------------
# E-mail de verificação do signup. Drivers:
#   log   = código sai no log do nest-api (docker compose logs nest-api | grep -i código)
#   smtp  = envia via SMTP (nodemailer). Preencha SMTP_* abaixo.
#   resend= envia via API do Resend (exige o pacote `resend` na imagem).
# Dica homolog: use smtp apontando pro Resend (sem instalar pacote novo):
#   SMTP_HOST=smtp.resend.com  SMTP_PORT=465  SMTP_SECURE=true
#   SMTP_USER=resend           SMTP_PASS=<RESEND_API_KEY>
#   MAIL_FROM=Norya <onboarding@resend.dev>   # ou remetente de domínio verificado
# Se a porta 465 estiver bloqueada na saída (comum em VPS), troque para
# SMTP_PORT=2465 (Resend oferece 2465/2587 como alternativas).
# ----------------------------------------------------------------------------
EMAIL_DRIVER=log
RESEND_API_KEY=
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

LOG_LEVEL=info
