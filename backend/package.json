{
  "name": "@sehloro/backend",
  "version": "0.1.0",
  "private": true,
  "description": "SEHLORO/SLMOD backend monorepo — NestJS strangler refactor of the SLMOD-api Express stack",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start:api": "pnpm --filter @sehloro/api start",
    "start:api:dev": "pnpm --filter @sehloro/api start:dev",
    "start:worker": "pnpm --filter @sehloro/worker start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @sehloro/api test:e2e",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\""
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "bcrypt",
      "esbuild",
      "mongodb-memory-server"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/platform-express": "^10.3.10",
    "mongoose": "^8.5.2",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "prettier": "^3.3.3",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
