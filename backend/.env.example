# =============================================================================
# SEHLORO / SLMOD backend — variáveis de ambiente
# Schema canônico validado por Zod em apps/api/src/config/config.schema.ts
# =============================================================================

# Runtime
NODE_ENV=development
API_PORT=3000
LOG_LEVEL=info

# Persistência (obrigatórios)
MONGODB_URI=mongodb://localhost:27017/sehloirostudios

# Auth (obrigatório, mínimo 32 chars)
JWT_SECRET=change-me-please-32-chars-minimum-secret-value
# TTL do access token. Aceita sufixos do jsonwebtoken (s/m/h/d). Default 15m.
JWT_ACCESS_TTL=15m
# TTL do refresh token, em dias. Default 7.
JWT_REFRESH_TTL_DAYS=7

# Cache / filas (opcional no M1)
REDIS_URL=redis://localhost:6379

# Event store (opcional no M1)
CLICKHOUSE_URL=http://localhost:8123

# LLM (opcional)
ANTHROPIC_API_KEY=

# Twitch OAuth (opcional no M1)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Kick OAuth (opcional no M1)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# CORS — CSV de origens permitidas (opcional; default cai para o valor hardcoded)
CORS_ORIGIN=https://slmoderacao.vercel.app

# Página/endpoint de access logs (GET /api/v2/logs + /logs no console).
# Basic Auth operacional, separada do JWT do produto. Os DOIS precisam estar
# setados para o endpoint existir (sem eles: 404). Senha mínima de 12 chars.
LOGS_USER=
LOGS_PASSWORD=

# Bootstrap do primeiro admin (gestão de acesso). Se ambos setados, o boot
# cria esse usuário com role=admin (idempotente; nunca promove conta já
# existente). Novos admins: somente pela página de gestão de acesso.
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Crypto — AES-256-GCM envelope de tokens OAuth (AUTH-02)
# OBRIGATÓRIA. Base64 de 32 bytes exatos. Gere com: openssl rand -base64 32
CRYPTO_MASTER_KEY=
# Chaves anteriores para rotação (CSV de base64 de 32 bytes cada). Opcional.
# Use durante janelas de rotação para conseguir decripta ciphertexts antigos
# — ciphertexts novos sempre usam CRYPTO_MASTER_KEY.
CRYPTO_PREV_KEYS=

# Email — verificação de email no sign-up (Fase 1)
# Driver: log (default, loga o código no console) | resend (API)
EMAIL_DRIVER=log
# Necessário quando EMAIL_DRIVER=resend
RESEND_API_KEY=
# Remetente. Ex.: 'SEHLORO <no-reply@sehloro.dev>'
MAIL_FROM=
# TTL do código de verificação em minutos (default 15)
EMAIL_CODE_TTL_MIN=15
