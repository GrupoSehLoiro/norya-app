{
  "name": "@sehloro/worker",
  "version": "0.1.0",
  "private": true,
  "description": "SEHLORO/SLMOD background worker (NestJS standalone app) — futuramente consome filas de ingestion/moderation",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "tsx --tsconfig tsconfig.dev.json src/main.ts",
    "start:dev": "tsx watch --tsconfig tsconfig.dev.json src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "jest --config jest.config.cjs --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@sehloro/infra": "workspace:*",
    "@sehloro/domain": "workspace:*",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "@types/ws": "^8.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
