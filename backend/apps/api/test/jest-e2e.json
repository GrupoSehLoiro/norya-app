{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec\\.ts$",
  "setupFiles": ["<rootDir>/jest-e2e.setup.ts"],
  "forceExit": true,
  "transform": {
    "^.+\\.(t|j)s$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.e2e.json" }]
  },
  "moduleNameMapper": {
    "^puppeteer-core$": "<rootDir>/stubs/puppeteer-core.stub.ts",
    "^@sehloro/domain$": "<rootDir>/../../../libs/domain/src",
    "^@sehloro/domain/(.*)$": "<rootDir>/../../../libs/domain/src/$1",
    "^@sehloro/infra$": "<rootDir>/../../../libs/infra/src",
    "^@sehloro/infra/(.*)$": "<rootDir>/../../../libs/infra/src/$1"
  }
}
