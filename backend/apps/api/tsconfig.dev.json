{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "ES2022",
    "module": "commonjs",
    "rootDir": "./src",
    "types": ["node", "jest"],
    "baseUrl": "../..",
    "paths": {
      "@sehloro/domain": ["libs/domain/src"],
      "@sehloro/domain/*": ["libs/domain/src/*"],
      "@sehloro/infra": ["libs/infra/src"],
      "@sehloro/infra/*": ["libs/infra/src/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
