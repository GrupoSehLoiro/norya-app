{
  "name": "@sehloro/api",
  "version": "0.1.0",
  "private": true,
  "description": "SEHLORO/SLMOD HTTP API (NestJS) — strangler successor to SLMOD-api",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "tsx --tsconfig tsconfig.dev.json src/main.ts",
    "start:dev": "tsx watch --tsconfig tsconfig.dev.json src/main.ts",
    "start:prod": "node dist/main.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config ./test/jest-e2e.json --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.10",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/schedule": "^6.1.3",
    "@sehloro/domain": "workspace:*",
    "@sehloro/infra": "workspace:*",
    "bcrypt": "^5.1.1",
    "ioredis": "^5.10.1",
    "mongoose": "^8.5.2",
    "nestjs-cls": "^4.4.1",
    "nestjs-pino": "^4.1.0",
    "nodemailer": "^9.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.19.0",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "pino-pretty": "^11.2.2",
    "puppeteer-core": "^25.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.4",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/ioredis-mock": "^8.2.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "@types/passport-jwt": "^4.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^6.0.2",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.10",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.dev.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^@sehloro/domain$": "<rootDir>/../../../libs/domain/src",
      "^@sehloro/domain/(.*)$": "<rootDir>/../../../libs/domain/src/$1",
      "^@sehloro/infra$": "<rootDir>/../../../libs/infra/src",
      "^@sehloro/infra/(.*)$": "<rootDir>/../../../libs/infra/src/$1"
    }
  }
}
