{
  "name": "@sehloro/infra",
  "version": "0.1.0",
  "private": true,
  "description": "Infrastructure adapters — implementações concretas dos contracts de @sehloro/domain (Mongo, ClickHouse, Redis, HTTP clients)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:cov": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "@clickhouse/client": "^1.10.0",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.3.10",
    "@nestjs/mongoose": "^10.0.10",
    "@sehloro/domain": "workspace:*",
    "axios": "^1.16.0",
    "ioredis": "^5.10.1",
    "mongoose": "^8.5.2",
    "nodemailer": "^9.0.1",
    "pusher-js": "^8.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tmi.js": "^1.8.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.3.10",
    "@types/ioredis": "^5.0.0",
    "@types/ioredis-mock": "^8.2.5",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "@types/tmi.js": "^1.8.6",
    "ioredis-mock": "^8.9.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.0.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4"
  }
}
