{
  "name": "@sehloro/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Domain layer (pure TS): entidades, value objects, contracts de repositório e erros de negócio",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": ["dist", "src"],
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.14",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "typescript": "^5.5.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.lib.json",
    "test": "jest --config jest.config.cjs --passWithNoTests",
    "test:cov": "jest --config jest.config.cjs --coverage"
  }
}
